# Telegram Bot Token (BotFather dan olinadi)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Bot asosiy adminlari ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# AI yordamchi uchun API kalitlar (ixtiyoriy, Gemini yoki OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Maksimal ogohlantirishlar soni (3 tadan so'ng mute)
MAX_WARNS=3

# Standart mute vaqti soniyalarda (3600 = 1 soat)
DEFAULT_MUTE_SECONDS=3600
